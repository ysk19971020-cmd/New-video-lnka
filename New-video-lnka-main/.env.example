# ── Database ────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

DATABASE_URL="file:./db/custom.db"

# ── Firebase (Client SDK — public, safe to expose) ──────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (Server-side — NEVER expose publicly) ─────────────────
# 1. Firebase Console → Project settings → Service accounts → Generate new private key
# 2. Copy the entire JSON content and paste it below as a single line
#    (or base64-encode it and decode in firebase-admin.ts if your host has size limits)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Admin config ─────────────────────────────────────────────────────────────
# Comma-separated list of Firebase user emails that have admin access
NEXT_PUBLIC_ADMIN_EMAILS=admin@yourdomain.com

# ── Oxapay (payment gateway) ──────────────────────────────────────────────────
OXAPAY_MERCHANT_ID=
OXAPAY_API_KEY=
# Set this to the webhook secret from the Oxapay dashboard (for callback signature verification)
OXAPAY_CALLBACK_SECRET=

# ── Vercel Blob (video/image storage) ────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── App URL (used in payment callback URLs) ───────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
